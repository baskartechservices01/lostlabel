# ==========================================
# LOST LABEL - Environment Configuration
# ==========================================

# Firebase Web App Config (Found in Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary Config (DO NOT expose API Secret here)
# Unsigned upload preset created for lost-label/products and lost-label/payment-proofs
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Default Fallback UPI Settings (Can also be managed via Admin Settings in Firestore)
VITE_DEFAULT_UPI_ID=lostlabel@upi
VITE_DEFAULT_UPI_NAME=Lost Label Streetwear
